{
  "schema_version": 1,
  "kind": "culture_taste_daily_candidate_policy",
  "timezone": "Asia/Shanghai",
  "mode": "scheduled_dry_run_candidate",
  "schedule": {
    "start_time": "09:30",
    "recovery_check_times": ["11:30", "13:30", "14:30"],
    "recover_when_current_candidate_missing": true,
    "research_window_start": "06:00",
    "research_lock_deadline": "15:00",
    "research_lock_deadline_effective_from": "2026-08-26",
    "historical_research_lock_deadline": "08:30"
  },
  "freshness_hours": 72,
  "official_image_gate": {
    "required": true,
    "effective_from": "2026-08-25",
    "required_origin_authority": "first_party_official",
    "required_source_relationship": "first_party_official",
    "original_visual_satisfies": false,
    "preview_external_allowed": true,
    "production_requires_cleared_rights": true
  },
  "daily_radar": {
    "public_file": "daily-radar.public.json",
    "supplemental_to_issue": true,
    "changes_issue_selection": false,
    "categories": ["fashion", "music", "objects", "city"],
    "minimum_items_per_category": 2,
    "first_party_official_media_required": true,
    "official_video_preferred_when_available": true,
    "included_in_rss": false,
    "fresh_event_gate_effective_from": "2026-08-26",
    "deduplication_lookback_days": 2,
    "source_coverage_attestation_required": true,
    "source_coverage_attestation_effective_from": "2026-08-27"
  },
  "dry_run_base_ref": "preview-build-v1",
  "branch_prefix": "automation/culture-taste",
  "output": {
    "open_pull_request": true,
    "merge": false,
    "deploy_preview": false,
    "deploy_production": false,
    "modify_pages_settings": false,
    "modify_legacy_repository": false
  },
  "failure": {
    "status": "BLOCKED",
    "preserve_previous_good": true,
    "allow_partial_publish": false
  },
  "required_source_lanes": [
    "mainland_china_plus_hong_kong_or_taiwan",
    "japan_or_korea",
    "continental_europe_or_united_kingdom",
    "united_states_or_canada",
    "rotating_global_lane"
  ],
  "brand_radar": {
    "registry": "automation/brand-radar.json",
