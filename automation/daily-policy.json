    "full_registry_daily_quick_scan": true,
    "publication_quota": false,
    "social_following_required": false
  },
  "cover_variation_gate": {
    "effective_from": "2026-08-26",
    "local_cover_required": true,
    "exact_asset_reuse_forbidden": true,
    "comparison_window_issues": 7
  },
  "standing_beats": [
    {
      "id": "supreme-thursday-drop",
      "cadence": "thursday",
