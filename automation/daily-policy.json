      "cadence": "daily",
      "required_check": true,
      "publication_quota": false
    },
    {
      "id": "luxury-runway-calendar",
      "cadence": "daily",
      "required_check": true,
      "publication_quota": false
    },
    {
      "id": "exhibition-and-cultural-programme-radar",
      "cadence": "daily",
      "required_check": true,
      "publication_quota": false
    },
    {
      "id": "small-breakout-object-radar",
      "cadence": "daily",
      "required_check": true,
      "publication_quota": false
    }
  ],
  "required_runtime_checks": [
    "canonical_harrytone_access_and_commit",
