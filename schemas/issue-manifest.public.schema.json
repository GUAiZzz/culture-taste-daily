{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guaizzz.github.io/schemas/issue-manifest.public.schema.json",
  "title": "Culture & Taste Daily Public Issue Manifest",
  "description": "Publishable issue metadata only. Private source-ledger notes, rejected candidates, internal scoring rationale, and unpublished editorial reasoning are forbidden here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "publication_date",
    "timezone",
    "status",
    "core_version",
    "content_lock",
    "harrytone",
    "language_mode",
    "editorial_position",
    "art_direction",
    "stories",
    "qa",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "issue_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "publication_date": { "type": "string", "format": "date" },
    "timezone": { "const": "Asia/Shanghai" },
    "status": { "enum": ["PASS", "DEGRADED", "BLOCKED"] },
    "core_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "content_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sha256", "locked_at"],
      "properties": {
        "status": { "const": "locked" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "locked_at": { "type": "string", "format": "date-time" }
      }
    },
    "language_mode": { "const": "zh-CN_full__en_title_deck_abstract" },
    "harrytone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit"],
      "properties": {
        "repository": { "const": "GUAiZzz/harry-tone" },
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "loaded_at": { "type": "string", "format": "date-time" }
      }
    },
    "editorial_position": { "type": "string", "minLength": 1 },
    "art_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dominant_mood",
        "background_logic",
        "palette_logic",
        "type_scale_logic",
        "image_behavior",
        "core_visual_action",
        "cover_composition",
        "mobile_translation",
        "mobbin_usability_constraint",
        "quiet_ending"
      ],
      "properties": {
        "dominant_mood": { "type": "string" },
        "background_logic": { "type": "string" },
        "palette_logic": { "type": "string" },
        "type_scale_logic": { "type": "string" },
        "image_behavior": { "type": "string" },
        "page_density_and_tempo": { "type": "string" },
        "core_visual_action": { "type": "string" },
        "cover_composition": { "type": "string" },
        "desktop_interaction_mechanic": { "type": "string" },
        "behance_viewing_arc": { "type": "string" },
        "mobile_translation": { "type": "string" },
        "mobbin_usability_constraint": { "type": "string" },
        "quiet_ending": { "type": "string" }
      }
    },
    "variation_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comparison_mode": { "enum": ["first_issue", "prior_issues"] },
        "compared_issue_dates": { "type": "array", "items": { "type": "string", "format": "date" }, "uniqueItems": true },
        "repeated_mechanisms": { "type": "array", "items": { "type": "string" } },
        "exception_reason": { "type": ["string", "null"] }
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "title", "sources"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "level": { "enum": ["cover", "major", "signal", "watch"] },
          "title": { "type": "string", "minLength": 1 },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "publisher", "url"],
              "properties": {
                "title": { "type": "string" },
                "publisher": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "published_date": { "type": ["string", "null"] },
                "event_date": { "type": ["string", "null"] }
              }
            }
          },
          "image_credit": { "type": ["string", "null"] }
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["html_parse", "assets", "internal_links", "no_js_reading", "desktop_render", "mobile_render", "reduced_motion"],
      "properties": {
        "html_parse": { "enum": ["pass", "fail", "unavailable"] },
        "assets": { "enum": ["pass", "fail", "unavailable"] },
        "internal_links": { "enum": ["pass", "fail", "unavailable"] },
        "no_js_reading": { "enum": ["pass", "fail", "unavailable"] },
        "accessibility": { "enum": ["pass", "fail", "unavailable"] },
        "desktop_render": { "enum": ["pass", "fail", "unavailable"] },
        "mobile_render": { "enum": ["pass", "fail", "unavailable"] },
        "reduced_motion": { "enum": ["pass", "fail", "unavailable"] }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
