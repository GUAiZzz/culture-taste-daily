{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://culture-taste-daily.invalid/schemas/issue-manifest.public.schema.json",
  "title": "Culture & Taste Daily Public Issue Manifest v2",
  "description": "Publishable metadata and generator reporting only. This manifest cannot authorize deployment and must never contain private source-ledger instances or review rationale.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "publication_date",
    "visibility",
    "timezone",
    "candidate_created_at",
    "research_locked_at",
    "content_locked_at",
    "status",
    "contract",
    "core_version",
    "content_lock",
    "source_hashes",
    "harrytone",
    "language_mode",
    "editorial_position",
    "art_direction",
    "variation_review",
    "stories",
    "rights_summary",
    "artifact_digests",
    "evidence_refs",
    "qa",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "issue_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "publication_date": { "type": "string", "format": "date" },
    "visibility": {
      "description": "Publication routing only. Future drafts are excluded from the public latest/archive feed; this field never authorizes deployment.",
      "enum": ["published_preview", "future_draft"]
    },
    "timezone": { "const": "Asia/Shanghai" },
    "candidate_created_at": {
      "description": "Null is allowed only for disclosed pre-V3 non-production material; the evidence gate blocks it.",
      "type": ["string", "null"],
      "format": "date-time"
    },
    "research_locked_at": { "type": "string", "format": "date-time" },
    "content_locked_at": { "type": "string", "format": "date-time" },
    "status": {
      "description": "Generator/publication reporting only; never deployment authority.",
      "enum": ["PASS", "DEGRADED", "BLOCKED"]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "commit", "activation_commit"],
      "properties": {
        "repository": { "const": "GUAiZzz/culture-taste-daily" },
        "path": { "const": "docs/PRODUCTION_CONTRACT_V3.md" },
        "commit": { "$ref": "#/$defs/sha1" },
        "activation_commit": { "$ref": "#/$defs/sha1" }
      }
    },
    "core_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "content_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sha256", "locked_at"],
      "properties": {
        "status": { "const": "locked" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "locked_at": { "type": "string", "format": "date-time" }
      }
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "art_direction_sha256", "issue_style_sha256"],
      "properties": {
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "art_direction_sha256": { "$ref": "#/$defs/sha256" },
        "issue_style_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "harrytone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit"],
      "properties": {
        "repository": { "const": "GUAiZzz/harry-tone" },
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/sha1" },
        "loaded_at": { "type": "string", "format": "date-time" }
      }
    },
    "language_mode": { "const": "zh-CN_full__en_title_deck_abstract" },
    "editorial_position": { "type": "string", "minLength": 1 },
    "art_direction": { "$ref": "#/$defs/artDirection" },
    "variation_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_mode", "compared_issue_dates", "repeated_mechanisms", "exception_reason"],
      "properties": {
        "comparison_mode": { "enum": ["first_issue", "prior_issues"] },
        "compared_issue_dates": {
          "type": "array",
          "items": { "type": "string", "format": "date" },
          "uniqueItems": true
        },
        "repeated_mechanisms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exception_reason": { "type": ["string", "null"] }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/story" }
    },
    "rights_summary": {
      "description": "Publishable summary only; private permission evidence stays outside the repository.",
      "type": "object",
      "additionalProperties": false,
      "required": ["required_assets", "unknown_required_assets", "status"],
      "properties": {
        "required_assets": { "type": "integer", "minimum": 0 },
        "unknown_required_assets": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["clear", "blocked"] }
      }
    },
    "artifact_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_payload_sha256"],
      "properties": {
        "issue_payload_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "evidence_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical", "editorial_visual", "gate"],
      "properties": {
        "technical": { "$ref": "#/$defs/evidenceRefList" },
        "editorial_visual": { "$ref": "#/$defs/evidenceRefList" },
        "gate": { "$ref": "#/$defs/evidenceRefList" }
      }
    },
    "qa": {
      "description": "Generator reporting only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["html_parse", "assets", "internal_links", "no_js_reading", "desktop_render", "mobile_render", "reduced_motion"],
      "properties": {
        "html_parse": { "$ref": "#/$defs/reportStatus" },
        "assets": { "$ref": "#/$defs/reportStatus" },
        "internal_links": { "$ref": "#/$defs/reportStatus" },
        "no_js_reading": { "$ref": "#/$defs/reportStatus" },
        "accessibility": { "$ref": "#/$defs/reportStatus" },
        "desktop_render": { "$ref": "#/$defs/reportStatus" },
        "mobile_render": { "$ref": "#/$defs/reportStatus" },
        "reduced_motion": { "$ref": "#/$defs/reportStatus" }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "media_required": { "type": "boolean" }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reportStatus": {
      "enum": ["pass", "fail", "unavailable"]
    },
    "evidenceRefList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "artDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dominant_mood",
        "background_logic",
        "palette_logic",
        "type_scale_logic",
        "image_behavior",
        "page_density_and_tempo",
        "core_visual_action",
        "cover_composition",
        "desktop_interaction_mechanic",
        "behance_viewing_arc",
        "mobile_translation",
        "mobbin_usability_constraint",
        "quiet_ending"
      ],
      "properties": {
        "dominant_mood": { "type": "string" },
        "background_logic": { "type": "string" },
        "palette_logic": { "type": "string" },
        "type_scale_logic": { "type": "string" },
        "image_behavior": { "type": "string" },
        "page_density_and_tempo": { "type": "string" },
        "core_visual_action": { "type": "string" },
        "cover_composition": { "type": "string" },
        "desktop_interaction_mechanic": { "type": "string" },
        "behance_viewing_arc": { "type": "string" },
        "mobile_translation": { "type": "string" },
        "mobbin_usability_constraint": { "type": "string" },
        "quiet_ending": { "type": "string" }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "title", "sources", "image_credit"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "level": { "enum": ["cover", "major", "signal", "watch"] },
        "title": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "publisher", "url", "published_date", "event_date"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "publisher": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" },
              "published_date": { "type": ["string", "null"] },
              "event_date": { "type": ["string", "null"] }
            }
          }
        },
        "image_credit": { "type": ["string", "null"] },
        "english": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "deck", "abstract"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "deck": { "type": "string", "minLength": 1 },
            "abstract": { "type": "string", "minLength": 1 }
          }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset", "alt", "caption", "credit", "kind", "rights_basis"],
          "properties": {
            "asset": { "type": "string", "pattern": "^assets/[A-Za-z0-9._/-]+$" },
            "alt": { "type": "string", "minLength": 1 },
            "caption": { "type": "string", "minLength": 1 },
            "credit": { "type": "string", "minLength": 1 },
            "kind": {
              "description": "How the local asset relates to the source. source_image is allowed only with a separately cleared rights basis.",
              "enum": ["source_image", "original_illustration", "data_diagram", "historical_artifact"]
            },
            "origin_url": {
              "description": "Public page or image-origin URL. This is provenance, not permission, and does not create a remote display dependency.",
              "type": ["string", "null"],
              "format": "uri"
            },
            "rights_basis": {
              "description": "Public label for the separately recorded usage-rights basis. found online, credit, or hotlink availability are not valid values.",
              "enum": ["owned_original", "open_license", "documented_permission", "public_domain", "historical_artifact_review"]
            }
          },
          "allOf": [
            {
              "if": { "properties": { "kind": { "const": "source_image" } } },
              "then": {
                "required": ["origin_url"],
                "properties": {
                  "origin_url": { "type": "string", "format": "uri" },
                  "rights_basis": { "enum": ["open_license", "documented_permission", "public_domain"] }
                }
              }
            },
            {
              "if": { "properties": { "kind": { "enum": ["original_illustration", "data_diagram"] } } },
              "then": {
                "properties": {
                  "rights_basis": { "const": "owned_original" },
                  "origin_url": { "type": "null" }
                }
              }
            },
            {
              "if": { "properties": { "kind": { "const": "historical_artifact" } } },
              "then": {
                "properties": {
                  "rights_basis": { "const": "historical_artifact_review" }
                }
              }
            }
          ]
        }
      }
    }
  }
}
